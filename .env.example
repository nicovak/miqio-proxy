ENV=DEV

PORT=8080

POSTGRES_CONNECTION_STRING=postgres://miqio:miqio@localhost:5432/miqio?sslmode=disable

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=miqio-lp-assets

MIQIO_PAGE_DOMAIN=miqio.page
CACHE_SYNC_INTERVAL=30s
LOG_LEVEL=info

APP_ORIGIN=https://app.miqio.page
